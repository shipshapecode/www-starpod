---
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<figure class:list={['overflow-hidden', className]}>
  <video
    class="block aspect-video w-full"
    controls
    loop
    muted
    playsinline
    preload="metadata"
    poster="/video/warp-sponsor-example.jpg"
    data-sponsor-autoplay
  >
    <source src="/video/warp-sponsor-example.mp4" type="video/mp4" />
  </video>
</figure>

<script>
  const init = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document
      .querySelectorAll<HTMLVideoElement>('[data-sponsor-autoplay]')
      .forEach((video) => {
        video.play().catch(() => {
          /* Autoplay refused; the controls are still there. */
        });
      });
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
