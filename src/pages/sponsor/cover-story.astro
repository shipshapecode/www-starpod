---
import { Image } from 'astro:assets';

import Layout from '../../layouts/Layout.astro';
import AdPackageCard from '../../components/AdPackageCard.astro';
import XPostCard from '../../components/sponsor/XPostCard.astro';
import CaseStudyVideo from '../../components/sponsor/CaseStudyVideo.astro';
import {
  adPackages,
  hostProfiles,
  partners,
  xPosts
} from 'src/data/sponsor';

import coverPhoto from '../../img/events/adam-cascadiajs-keynote.jpg';
import spreadPhoto from '../../img/events/hosts-cascadiajs-podium.jpg';
import robbiePhoto from '../../img/events/robbie-cascadiajs-podium.jpg';
import livePhoto from '../../img/events/adam-live-shaundai.jpg';
import crowdPhoto from '../../img/events/cascadiajs-crowd-hands.jpg';

const [robbie, adam] = hostProfiles;
const featuredPosts = xPosts.slice(0, 2);
---

<Layout title="Sponsor — The Cover Story">
  <meta slot="head" name="robots" content="noindex" />

  <div class="cover-story relative z-10 mb-2 px-8 pb-8 lg:px-18 lg:pb-16">
    <!--
    THESIS: The page is an editorial profile OF the hosts, not a media kit;
    the sponsor reads a feature and reaches the rate card convinced. Refuses
    the stats-first pitch wall.
    OWN-WORLD: The site's light/dark oklch system and Inter throughout;
    magazine grammar carried by weight and rules — masthead row, cover-scale
    photo, drop cap, hairline-ruled pull-stat rail, print-credit captions;
    purple/cyan accents only as underline and rule color.
    STORY: A sponsor reads who these two are, believes their reach because it
    is shown as clippings and pull stats mid-story, and ends at a rate card
    signed by the hosts.
    FIRST VIEWPORT: Masthead row above a full-width cover photo (Adam mid-talk,
    stained glass); cover line "The two developers your audience already
    follows" over its lower third; dek names real numbers; corner flash links
    to the rate card.
    FORM: Magazine feature profile; candidate 2 of 7; seed 153ac46c.
    FINISH: unreviewed and undocumented is unfinished; this build ends with
    the finish review, the verdict, DESIGN.md, and every shipping raster
    carrying its provenance.
    -->

    <header class="dark:border-dark-border flex items-baseline justify-between gap-4 border-b-2 border-gray-900 pb-3 dark:border-white/80">
      <p
        class="text-light-text-heading text-sm font-extrabold tracking-[0.2em] uppercase dark:text-white"
      >
        Whiskey Web &amp; Whatnot
      </p>
      <p class="text-sm tabular-nums">The Sponsor Issue · 2026</p>
    </header>

    <section class="relative mt-6">
      <figure class="relative overflow-hidden rounded-2xl">
        <Image
          class="cover-photo aspect-[4/5] w-full object-cover sm:aspect-[16/10]"
          src={coverPhoto}
          alt="Adam Argyle giving a talk at CascadiaJS 2026 beneath stained-glass windows"
          widths={[640, 960, 1440, 1920]}
          sizes="(min-width: 1024px) 56rem, 100vw"
          loading="eager"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-black/10"
        >
        </div>

        <a
          href="#rate-card"
          class="absolute top-4 right-4 rounded-full bg-[#8A63FF] px-4 py-2 text-sm font-bold text-white shadow-lg transition-transform hover:scale-105 dark:bg-[#42C8F3] dark:text-black"
        >
          Partner with us
        </a>

        <figcaption
          class="absolute right-0 bottom-0 left-0 p-6 lg:p-10"
        >
          <h1
            class="cover-line max-w-3xl text-4xl leading-[1.02] font-extrabold text-balance text-white lg:text-6xl"
          >
            The two developers your audience already follows
          </h1>
          <p class="cover-dek mt-4 max-w-2xl text-lg text-white/90 lg:text-xl">
            58.5K and 7.1K followers on X. 10.9K YouTube subscribers. A top
            10% podcast. And a whiskey budget that is, frankly, out of
            control.
          </p>
        </figcaption>
      </figure>
    </section>

    <section class="mt-10 lg:mt-14">
      <p
        class="text-light-text-heading max-w-3xl text-xl leading-relaxed font-semibold text-pretty lg:text-2xl dark:text-white"
      >
        Robbie Wagner and Adam Argyle record Whiskey Web and Whatnot every
        week: a whiskey-fueled fireside chat about AI, the modern web, and
        the humans behind the code. Sponsoring the show doesn't buy a slot on
        a spreadsheet — it buys these two, on the record, telling their
        audience about you.
      </p>
      <p class="dark:border-dark-border mt-6 border-b pb-6 text-sm">
        Photography from CascadiaJS 2026, Seattle — where the hosts emceed on
        the mainstage.
      </p>
    </section>

    <section class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_16rem]">
      <div class="feature-copy max-w-none">
        <p class="drop-cap text-[17px] leading-[1.8]">
          Start with who they are. Robbie slings JavaScript at HashiCorp and
          slung it for Amazon, Netflix, and Apple before that; he also runs
          the consultancy Ship Shape. Adam is a design engineer at Shopify by
          way of Google Chrome, sits in the CSS Working Group, co-hosted The
          CSS Podcast, and built Open Props and gradient.style. When one of
          them says your product is good, senior engineers hear it from
          someone whose code they already use.
        </p>
        <p class="mt-6 text-[17px] leading-[1.8]">
          The show blends technical depth with premium lifestyle content —
          web development, software architecture, and fine whiskey, rated on
          an extremely scientific tentacle scale. The audience skews senior:
          engineering managers, architects, web and backend developers, half
          of them in the US, the rest spread from the UK to Australia.
        </p>
        <blockquote
          class="my-10 border-y-2 border-gray-900 py-8 dark:border-white/80"
        >
          <p
            class="text-light-text-heading text-2xl leading-snug font-bold text-balance lg:text-3xl dark:text-white"
          >
            “Host-read ads are baked into the episode forever. Your spot is
            still converting when the episode is three years old.”
          </p>
        </blockquote>
        <p class="text-[17px] leading-[1.8]">
          That's the mechanism: no programmatic insertion, no ephemeral
          banner. The hosts read every spot themselves, in their own voice,
          inside content that keeps getting downloaded — 3 to 10 thousand
          times per episode, over 100 thousand impressions a month once
          video and social do their rounds.
        </p>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-8 lg:self-start">
        <div
          class="dark:border-dark-border border-t-2 border-gray-900 pt-4 dark:border-white/80"
        >
          <p class="text-light-text-heading text-4xl font-extrabold tabular-nums dark:text-white">
            76K+
          </p>
          <p class="mt-1 text-sm">
            combined X followers across {robbie.name.split(' ')[0]}, {
              adam.name.split(' ')[0]
            }, and the show
          </p>
        </div>
        <div
          class="dark:border-dark-border border-t-2 border-gray-900 pt-4 dark:border-white/80"
        >
          <p class="text-light-text-heading text-4xl font-extrabold tabular-nums dark:text-white">
            100K+
          </p>
          <p class="mt-1 text-sm">monthly impressions across audio, video, and social</p>
        </div>
        <div
          class="dark:border-dark-border border-t-2 border-gray-900 pt-4 dark:border-white/80"
        >
          <p class="text-light-text-heading text-4xl font-extrabold tabular-nums dark:text-white">
            Top 10%
          </p>
          <p class="mt-1 text-sm">
            of podcasts worldwide by downloads, per
            <a
              href="https://www.buzzsprout.com/stats#:~:text=Top%2010%25,441"
              class="underline decoration-[#8A63FF]/50 underline-offset-4 hover:decoration-[#8A63FF] dark:decoration-[#42C8F3]/50 dark:hover:decoration-[#42C8F3]"
              >Buzzsprout</a
            >
          </p>
        </div>
      </aside>
    </section>

    <section class="mt-14">
      <figure>
        <div class="overflow-hidden rounded-2xl">
          <Image
            class="w-full object-cover"
            src={spreadPhoto}
            alt="Robbie Wagner and Adam Argyle sharing a bottle of bourbon at the CascadiaJS podium"
            widths={[640, 960, 1440, 1920]}
            sizes="(min-width: 1024px) 56rem, 100vw"
          />
        </div>
        <figcaption class="mt-2 text-sm">
          The hosts and the evening's research material, CascadiaJS 2026.
        </figcaption>
      </figure>

      <div class="mt-4 grid grid-cols-2 gap-4">
        <figure>
          <div class="overflow-hidden rounded-2xl">
            <Image
              class="aspect-[4/3] w-full object-cover"
              src={robbiePhoto}
              alt="Robbie Wagner speaking at the CascadiaJS podium"
              widths={[480, 768, 1080]}
              sizes="(min-width: 1024px) 28rem, 50vw"
            />
          </div>
          <figcaption class="mt-2 text-sm">
            Robbie announcing the conference's layoff-relief donation.
          </figcaption>
        </figure>
        <figure>
          <div class="overflow-hidden rounded-2xl">
            <Image
              class="aspect-[4/3] w-full object-cover"
              src={livePhoto}
              alt="Adam Argyle recording a live episode with Shaundai Person"
              widths={[480, 768, 1080]}
              sizes="(min-width: 1024px) 28rem, 50vw"
            />
          </div>
          <figcaption class="mt-2 text-sm">
            Recording live with Shaundai Person — the show tours conference
            floors.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="mt-14">
      <h2
        class="dark:border-dark-border border-t-2 border-gray-900 pt-4 text-sm font-extrabold tracking-[0.2em] uppercase dark:border-white/80"
      >
        As seen on your feed
      </h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        {featuredPosts.map((post) => <XPostCard post={post} />)}
      </div>
    </section>

    <section
      class="dark:border-dark-border dark:bg-dark-background mt-14 rounded-2xl border border-gray-200 bg-white p-6 lg:p-10"
    >
      <h2
        class="text-light-text-heading text-2xl font-bold text-balance lg:text-3xl dark:text-white"
      >
        Case in point: Warp ran 90 days with us
      </h2>
      <p class="mt-3 max-w-2xl text-lg">
        Hear what a host-read campaign sounds like when it's baked into the
        feed.
      </p>
      <CaseStudyVideo class="mt-6 rounded-xl" />
      <a
        href="/sponsors/warp"
        class="group text-light-text-heading mt-6 inline-flex items-center gap-3 font-semibold dark:text-white"
      >
        See the 90-day results
        <svg
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14m-7-7l7 7-7 7"></path>
        </svg>
      </a>
    </section>

    <section class="mt-14">
      <h2
        class="dark:border-dark-border border-t-2 border-gray-900 pt-4 text-sm font-extrabold tracking-[0.2em] uppercase dark:border-white/80"
      >
        Previously featuring
      </h2>
      <ul class="dark:divide-dark-border mt-2 divide-y divide-gray-200">
        {
          partners.map((partner) => (
            <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-6">
              <a
                href={partner.url}
                target="_blank"
                rel="noopener"
                class="text-light-text-heading w-36 shrink-0 font-bold dark:text-white"
              >
                {partner.name}
              </a>
              <p class="text-[15px]">
                {partner.blurb}
                {partner.caseStudy && (
                  <a
                    href={partner.caseStudy}
                    class="text-light-text-heading font-semibold underline decoration-[#8A63FF]/50 underline-offset-4 hover:decoration-[#8A63FF] dark:text-white dark:decoration-[#42C8F3]/50 dark:hover:decoration-[#42C8F3]"
                  >
                    Read the case study.
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="rate-card" class="mt-14 scroll-mt-8">
      <div
        class="dark:border-dark-border flex items-baseline justify-between border-b-2 border-gray-900 pb-3 dark:border-white/80"
      >
        <h2
          class="text-light-text-heading text-3xl font-extrabold lg:text-4xl dark:text-white"
        >
          The rate card
        </h2>
        <p class="text-sm">Self-serve · host-read · evergreen</p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {
          adPackages.map((pkg) => (
            <AdPackageCard
              bullets={pkg.bullets}
              heading={pkg.heading}
              price={pkg.price}
              period={pkg.period}
              productId={import.meta.env[pkg.envKey] || `YOUR_${pkg.envKey}`}
            />
          ))
        }
      </div>
    </section>

    <section class="relative mt-14 overflow-hidden rounded-2xl">
      <Image
        class="absolute inset-0 h-full w-full object-cover"
        src={crowdPhoto}
        alt="The CascadiaJS audience raising hands during the hosts' session"
        widths={[640, 960, 1440]}
        sizes="(min-width: 1024px) 56rem, 100vw"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/55 to-black/45"
      >
      </div>
      <div class="relative p-8 py-16 lg:p-14">
        <p class="max-w-xl text-2xl font-bold text-balance text-white lg:text-3xl">
          Have an idea that isn't on the rate card?
        </p>
        <p class="mt-3 max-w-xl text-lg text-white/85">
          The weird ones are usually our favorites. We're down to chat.
        </p>
        <a class="btn mt-7 inline-flex" href="/contact">
          <span
            class="text-light-text-heading rounded-full bg-white px-8 py-3 text-center text-sm dark:bg-transparent dark:text-white"
          >
            Pitch us your idea
          </span>
        </a>
        <p class="mt-10 text-sm font-semibold text-white/70">
          — Robbie &amp; Adam, Whiskey Web and Whatnot
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .drop-cap::first-letter {
    float: left;
    margin-right: 0.5rem;
    font-size: 4.4em;
    line-height: 0.82;
    font-weight: 800;
    color: light-dark(var(--color-light-text-heading), white);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cover-line,
    .cover-dek {
      animation: cover-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .cover-dek {
      animation-delay: 0.15s;
    }
  }

  @keyframes cover-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
